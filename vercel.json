{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/api/currency",               "destination": "/api/currency.js" },
    { "source": "/api/scorecard",              "destination": "/api/scorecard.js" },
    { "source": "/api/submit-validator",       "destination": "/api/submit-validator.js" },
    { "source": "/api/webhook-validator",      "destination": "/api/webhook-validator.js" },
    { "source": "/api/report-viewer",          "destination": "/api/report-viewer.js" },
    { "source": "/api/submit-business-plan",   "destination": "/api/submit-business-plan.js" },
    { "source": "/api/webhook-business-plan",  "destination": "/api/webhook-business-plan.js" },
    { "source": "/scorecard",                  "destination": "/scorecard.html" },
    { "source": "/validator",                  "destination": "/validator.html" },
    { "source": "/validator/success",          "destination": "/success.html" },
    { "source": "/business-plan",              "destination": "/business-plan.html" },
    { "source": "/business-plan/success",      "destination": "/business-plan.html" },
    { "source": "/report/:id",                 "destination": "/api/report-viewer.js?id=:id" },
    { "source": "/business-plan/report/:id",   "destination": "/api/report-bp-viewer.js?id=:id" }
  ]
}
